# easier-to-deploy-storefronts — environment variables
#
# SETUP:
#   1. Copy this file to `.env.local` (already gitignored).
#   2. Fill in real values from the providers below.
#   3. For Vercel production, set the SAME keys in Vercel dashboard:
#      Project → Settings → Environment Variables (check Production + Preview).
#   4. NEVER commit `.env.local`. NEVER paste these values into chat, Slack, or GitHub issues.
#
# Empty defaults are fail-closed everywhere — code returns 503 / 401 rather than
# pretending to work. Set every variable before going live.

# ============== Convex ==============
# Get from: `npx convex dev` after `npm create convex@latest` (or pull from existing project).
# CONVEX_DEPLOYMENT format: `prod:<name>` for prod, `dev:<name>` for dev.
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=https://<your-deployment>.convex.site

# ============== Admin gateway ==============
# 32-char random string. Generate once, paste into BOTH Vercel and Convex envs.
# This is the legacy raw key — only servers should hold it. End-users authenticate
# via the email magic-link flow (ADMIN_EMAIL_ALLOWLIST below) and get session
# tokens (ses_<hex>); the raw key stays server-only.
ADMIN_API_KEY=

# Where the public site lives. Used to build magic-link URLs and redirect targets.
PUBLIC_BASE_URL=https://<your-app>.vercel.app

# ============== Magic-link auth (Resend-powered) ==============
# Comma-separated owner email(s). Empty allowlist = no logins permitted.
# Example: ADMIN_EMAIL_ALLOWLIST=owner@example.com,partner@example.com
ADMIN_EMAIL_ALLOWLIST=

# Resend account: https://resend.com/api-keys (free tier: 3k emails/month, 100/day)
# Sender must be on a verified domain. For dev, `onboarding@resend.dev` works.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ============== Notification recipients (separate from auth allowlist) ==============
# Where /api/contact + /api/admin/notify deliver. Empty = that target is skipped.
# Typical: MOM_EMAIL is the owner, OWNER_EMAIL is the developer/operator copy.
MOM_EMAIL=
OWNER_EMAIL=

# Phone shown in customer-facing copy (auto-replies, signature blocks).
# Format: digits only with country code, e.g. 14155551234
MOM_PHONE=

# ============== LLM (OpenRouter — translation, agent) ==============
# Get at: https://openrouter.ai/settings/keys
# Default model: moonshotai/kimi-k2-0905 (cheap, strong at zh<->en).
# Fallbacks baked into api/contact.js: qwen/qwen3-max, deepseek/deepseek-chat-v3.1:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2-0905

# ============== Optional integrations (commented = unused) ==============
# Rate limiting / persistence:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Logs:
# AXIOM_TOKEN=
# AXIOM_DATASET=marketplace-contact
# Google Calendar (booking sync):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=
